# PLACEWISE Environment Variables
# Copy this file to .env and fill in your API credentials.

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Gnani Voice AI (Prisma v2.5 STT & Timbre v2.5 TTS)
GNANI_API_KEY=
GNANI_API_URL=https://asr.gnani.ai/api/v1/asr
GNANI_LANG=en-IN
GNANI_TTS_URL=https://tts.gnani.ai/api/v1/tts

# LLM Instruction Understanding (Google Gemini Flash)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=auto
